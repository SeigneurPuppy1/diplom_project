[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[master]
${master_name} ansible_host=${master_ip} internal_ip=${master_internal_ip}

[worker]
${worker_name} ansible_host=${worker_ip} internal_ip=${worker_internal_ip}

[k8s_cluster:children]
master
worker

[jenkins]
${jenkins_name} ansible_host=${jenkins_ip} internal_ip=${jenkins_internal_ip}
